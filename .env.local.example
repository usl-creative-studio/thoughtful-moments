# thoughtful-moments -- Environment Variable Template
# Copy this file to .env and fill in your values.
# This file is committed to the repo as a reference.

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
NOTIFY_EMAIL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. Resend sends from a verified domain; unset, the onboarding sender is used and delivers to the account owner only.
RESEND_FROM_EMAIL=
